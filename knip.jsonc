{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // knip reads the scripts the workflows run; these others are run by path and never imported: the CLI
  // and the PR watch, thread and comment scripts by hand, the hooks from .claude/settings.json, the ratchet's
  // config by check-exception-ratchet.ts.
  "entry": [
    "app/src/cli.ts",
    "scripts/land-loop/pr-watch.ts",
    "scripts/land-loop/thread.ts",
    "scripts/land-loop/comment.ts",
    "scripts/land-loop/stop/hook.ts",
    "scripts/hooks/fix-edited.ts",
    "scripts/lint/exception-ratchet.oxlint.config.ts",
  ],
  "project": ["**/*.ts"],
  "ignore": ["scripts/vendor/anti-slop/**"],
}
