{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Run by path and never imported: the CLI and the Worker bench by hand, the factory's processes
  // (factory/bin/) and its session hooks (factory/hooks/) by the workflows, the settings, the skills and
  // the Stop hook, the edit hook from .claude/settings.json, the ratchet's config by
  // check-exception-ratchet.ts.
  "entry": [
    "app/src/cli.ts",
    "factory/bin/*.ts",
    "factory/hooks/*.ts",
    "scripts/lab/bench.ts",
    "scripts/hooks/fix-edited.ts",
    "scripts/lint/exception-ratchet.oxlint.config.ts",
  ],
  "project": ["**/*.ts"],
  "ignore": ["scripts/vendor/anti-slop/**", ".claude/plugins/**"],
}
