{
  "name": "software-factory-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c oxlint.config.ts --deny-warnings --format=unix",
    "format:check": "bun fmt --check .",
    "gates": "bun scripts/gates/check-lint-disables.ts && bun scripts/gates/check-typecheck-coverage.ts && bun scripts/gates/check-exception-ratchet.ts",
    "knip": "knip",
    "test": "bun test",
    "mods": "node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude plugin validate .claude/plugins/land && node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude plugin test .claude/plugins/land",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run gates && bun run knip && bun run mods && bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/gates/check-coverage-floor.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.92.0",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "fast-check": "4.10.2",
    "knip": "6.44.1",
    "oxlint": "1.92.0",
    "oxlint-plugin-complexity": "4.1.0",
    "oxlint-tsgolint": "7.0.2006"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "effect": "4.1.2"
  }
}
